{
  "name": "restaurant-order-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src tests vite.config.ts playwright.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.19.0"
}
