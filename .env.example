# Example values for local development only. Initialize-Dev.ps1 generates a local password.
POSTGRES_DB=restaurant_order
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=example_only_replace_me
DB_HOST=127.0.0.1
DB_PORT=54329
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=demo
# Initialize-Dev.ps1 appends DEMO_STAFF_PASSWORD and DEMO_KITCHEN_PASSWORD with random values.
# Demo users are inserted once, never reset on restart. Do not use demo profile in production.
# SESSION_COOKIE_SECURE=true is required with HTTPS before use beyond localhost.
